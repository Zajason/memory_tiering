# Keep GitHub's language bar pointing at the actual work.
#
# The profiler is C++ and the analysis is Python, but generated artefacts are
# far larger by byte count and would otherwise dominate the statistics and make
# a systems project read as something else.

# Generated figures and captured results are data, not source.
docs/assets/** linguist-generated
results/** linguist-generated

# docs/index.html is the generated GitHub Pages site, built by
# src/analysis/build_site.py, not hand-written HTML.
docs/index.html linguist-generated

# docs/app.js draws the interactive views. It is hand-written, but at ~13 KB it
# would still read as "this is a JavaScript project" next to the C++ that
# matters. Vendored, not generated: it is source, just not the point.
docs/app.js linguist-vendored
