# Papers (large PDFs, freely available online — see README links)
study/papers/*.pdf

# Simulator artifacts
*.o
*.so
build/
m5out/
checkpoints/
*.img
*.gz
vmlinux*

# Raw results — keep plots and summaries, not gigabytes of traces
results/**/*.trace
results/**/*.csv.gz
results/**/raw/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Benchmark sources and datasets (fetched by benchmarks/setup_*.sh)
bench/

# Pintool build output
src/profiler/pintool/obj-intel64/
src/profiler/validate/synth
benchmarks/zipf_client
benchmarks/zipf_selftest

# Raw per-page dumps are large; keep summaries, CSVs and figures
results/**/*.pages.bin
results/**/*.run.log
results/**/*.server.log
results/**/*.client.log
