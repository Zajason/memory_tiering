# Papers (large PDFs, freely available online — see README links)
papers/*.pdf

# Simulator artifacts
*.o
*.so
build/
m5out/
checkpoints/
*.img
*.gz
vmlinux*

# Raw results — keep plots and summaries, not gigabytes of traces
results/**/*.trace
results/**/*.csv.gz
results/**/raw/

# Python
__pycache__/
*.pyc
.venv/
.local-build-tools/
venv/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Benchmark sources and datasets (fetched by benchmarks/setup_*.sh)
workloads/

# Pintool build output
src/profiler/pintool/obj-intel64/
src/profiler/validate/synth
benchmarks/zipf_client
benchmarks/zipf_selftest

# Run logs are regenerable console output, not results. The older rule only
# covered results/**/*.run.log, so 16 top-level *_run.log files were committed
# before this was noticed.
results/*.log

# Raw per-page dumps are large; keep summaries, CSVs and figures
results/**/*.pages.bin
results/**/*.run.log
results/**/*.server.log
results/**/*.client.log
results/**/*.paired.csv
results/**/*.pages.bin.gz
results/**/*.dmtcp
results/**/dmtcp_restart_script*.sh
results/**/ckpt_*_files/

# Trained-model outputs are regenerable and large (kdda.model is 75 MB).
results/**/*.model

# Per-key top-K dumps run to millions of rows for tc/pr. The summaries and the
# analysis JSON that the figures are built from are kept; these are not.
results/**/*.topk.csv

# gem5 writes a full stats dump per run; the probe summary is what we analyse.
results/**/stats.txt
results/**/config.ini
results/**/config.json
results/**/*.lock
dmtcp_restart_script*.sh
pinos.log.*
/presentation/latest.json
