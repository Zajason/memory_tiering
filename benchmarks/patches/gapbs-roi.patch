GAPBS region-of-interest markers for the hotskew pintool.

This brackets only the *timed* kernel call in BenchmarkKernel() -- exactly the region
GAPBS itself reports as "Trial Time". Graph construction, CSR building, the squishing
pass and verification all stay outside. No kernel code is touched and no compiler
flags change, so the measured access pattern is the stock one.

Apply with:  git -C workloads/gapbs apply ../../benchmarks/patches/gapbs-roi.patch

--- a/src/benchmark.h
+++ b/src/benchmark.h
@@ -18,6 +18,7 @@
 #include "timer.h"
 #include "util.h"
 #include "writer.h"
+#include "hotskew_roi.h"


 /*
@@ -104,7 +105,9 @@ void BenchmarkKernel(const CLApp &cli, const GraphT_ &g,
   Timer trial_timer;
   for (int iter=0; iter < cli.num_trials(); iter++) {
     trial_timer.Start();
+    hotskew_roi_begin();
     auto result = kernel(g);
+    hotskew_roi_end();
     trial_timer.Stop();
     PrintTime("Trial Time", trial_timer.Seconds());
     total_seconds += trial_timer.Seconds();
