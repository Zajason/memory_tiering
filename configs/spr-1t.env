# Sapphire Rapids with M5's 1-thread CAT partition.
# Used for: Redis under YCSB.
# CAT mask 0x4000 -> 1 of 15 L3 ways -> 4 MB. This is the tightest partition in the
# paper and it is why Redis shows the most extreme sparsity in M5's Figure 4.
CFG_NAME="spr-1t"
L1_KB=48;    L1_ASSOC=12
L2_KB=2048;  L2_ASSOC=16
L3_KB=4096;  L3_ASSOC=1
