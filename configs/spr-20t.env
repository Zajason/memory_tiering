# Intel Xeon Gold 6430 (Sapphire Rapids) with M5's 20-thread CAT partition.
# Used for: GAPBS (bc bfs cc pr sssp tc), Liblinear.
# CAT mask 0x7FC0 -> 9 of 15 L3 ways -> 36 MB.
CFG_NAME="spr-20t"
L1_KB=48;    L1_ASSOC=12     # SPR L1d: 48 KB, 12-way, private
L2_KB=2048;  L2_ASSOC=16     # SPR L2:  2 MB,  16-way, private
L3_KB=36864; L3_ASSOC=9      # 9 of 15 ways of the shared 60 MB L3
